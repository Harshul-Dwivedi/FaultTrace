{
  "code": "P0171",
  "title": "System Too Lean (Bank 1)",
  "common_causes": [
    { "cause": "vacuum_leak", "prior": 0.3, "label": "Vacuum leak (intake manifold, hoses, brake booster)" },
    { "cause": "maf_fault", "prior": 0.2, "label": "MAF sensor under-reporting airflow" },
    { "cause": "o2_sensor_fault", "prior": 0.25, "label": "O2 sensor biased lean or failed" },
    { "cause": "weak_fuel_delivery", "prior": 0.15, "label": "Weak fuel delivery (pump, filter, injectors)" },
    { "cause": "ignition_fault", "prior": 0.1, "label": "Ignition fault (coils, plugs, wires)" }
  ],
  "characteristic_signatures": {
    "vacuum_leak": "Fuel trims rise immediately with load; MAF reads low with consistent proportional offset; O2 leans out under load but still switches.",
    "maf_fault": "MAF readings erratic or implausible; trims proportional to MAF error; MAF variance high.",
    "o2_sensor_fault": "O2 voltage flatlined or railed with no switching; fuel trims climb GRADUALLY over time as ECU integrates the false signal; MAF reads correctly.",
    "weak_fuel_delivery": "Trims go NEGATIVE at high load; fuel pressure drops under demand.",
    "ignition_fault": "Misfires on specific cylinders; trims near normal."
  },
