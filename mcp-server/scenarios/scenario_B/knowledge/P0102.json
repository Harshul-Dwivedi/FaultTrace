    { "cause": "maf_ground_fault", "prior": 0.15, "label": "MAF ground circuit fault" },
    { "cause": "air_intake_restrict", "prior": 0.1, "label": "Air intake restriction upstream of MAF" },
    { "cause": "ecu_fault", "prior": 0.1, "label": "ECU MAF input circuit fault" }
  ],
  "characteristic_signatures": {
    "maf_contamination": "MAF reads consistently low with erratic spikes; contamination often from PCV oil vapor or dirty air filter; trims compensate proportionally.",
    "maf_electrical_fault": "MAF signal may drop to zero or exhibit intermittent dropouts; correlated with electrical noise.",
    "maf_ground_fault": "MAF reading offset by a constant; all readings shifted uniformly.",
    "air_intake_restrict": "MAF reads low but smoothly; restriction upstream causes uniform under-reporting without spikes.",
    "ecu_fault": "MAF input circuit voltage out of spec; other sensors may also be affected."
  },
